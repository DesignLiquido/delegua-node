        "@designliquido/delegua-yaml": "^0.0.2",
        "@types/estree": "^1.0.7",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.15.21",
        "@types/node-fetch": "^2.6.13",
        "copyfiles": "^2.4.1",
        "jest": "^29.7.0",
        "jest-mock-process": "^2.0.0",
        "release-it": "^19.0.2",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.3.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    }
