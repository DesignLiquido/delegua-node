{
    "name": "@designliquido/delegua-node",
    "version": "1.18.6",
    "description": "Linguagem Delégua com capacidades para ecossistema Node.js.",
    "bin": {
        "delegua": "bin/delegua",
        "delegua-dap": "bin/delegua-dap"
    },
    "scripts": {
        "empacotar": "yarn rimraf ./dist && yarn tsc && yarn copyfiles -V ./bin/delegua ./bin/delegua.cmd ./bin/delegua-dap ./bin/delegua-dap.cmd ./dist && yarn copyfiles -V ./package.json ./README.md ./LICENSE ./dist",
        "testes-unitarios": "yarn jest --coverage",
        "testes:egua": "./bin/delegua-ts --dialeto egua exemplos/dialetos/egua-classico/testes.egua",
        "testes:delegua:bhaskara": "./bin/delegua-ts exemplos/dialetos/egua-classico/bhaskara.egua",
        "testes:delegua:fibonacci": "./bin/delegua-ts exemplos/dialetos/egua-classico/fibonacci.egua",
        "testes:egua-classico": "./bin/delegua-ts --dialeto egua exemplos/dialetos/egua-classico/testes.egua",
        "testes:servidor-depuracao": "yarn ts-node ./fontes/depuracao/servidor-depuracao.ts"
    },
    "dependencies": {
        "@designliquido/birl": "^0.6.1",
        "@designliquido/delegua": "^1.22.0",
        "@designliquido/delegua-interface-grafica": "^0.1.0",
        "@designliquido/mapler": "^0.7.1",
        "@designliquido/portugol-studio": "^0.11.1",
        "@designliquido/potigol": "^0.11.1",
        "@designliquido/visualg": "^0.9.1",
        "canvas": "^3.2.1",
        "chalk": "4.1.2",
        "commander": "^14.0.0",
        "json-colorizer": "^3.0.1",
        "node-fetch": "2"
    },
    "devDependencies": {
        "@designliquido/delegua-arquivos": "^0.0.4",
        "@designliquido/delegua-criptografia": "^0.3.4",
        "@designliquido/delegua-csv": "^0.0.3",
        "@designliquido/delegua-dados": "^0.0.1",
        "@designliquido/delegua-entidades": "^0.0.6",
        "@designliquido/delegua-estatistica": "^0.1.1",
        "@designliquido/delegua-fisica": "^0.1.0",
        "@designliquido/delegua-http": "^0.1.3",
        "@designliquido/delegua-imagens": "^0.0.0",
        "@designliquido/delegua-json": "^0.3.0",
        "@designliquido/delegua-matematica": "^0.4.0",
