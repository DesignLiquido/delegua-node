funcao contarNavesBumerangues(digitos) {
  var sequencias = []
  var primeiroDigito = nulo
  var segundoDigito = nulo
  para cada digito em digitos {
    se primeiroDigito == nulo {
      primeiroDigito = digito
      continua
    }

    se segundoDigito == nulo {
      se digito != primeiroDigito {
        segundoDigito = digito
      } senão {
        primeiroDigito = nulo
      }

      continua
    }

    se digito == primeiroDigito {
      sequencias.adicionar([primeiroDigito, segundoDigito, digito])
      primeiroDigito = nulo
      segundoDigito = nulo
    }
  }

  retorna sequencias
}

escreva(contarNavesBumerangues([1, 2, 1, 3, 4, 3, 5, 1, 5]))