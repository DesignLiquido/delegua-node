const json = importar('json')
const jsonFuncionarios = json.importarArquivoJson('./funcionarios.json')

var totalSalarios = 0
var numeroFuncionarios = 0
var pessoaSalarioMaximo = jsonFuncionarios.funcionarios[0]
var pessoaSalarioMinimo = jsonFuncionarios.funcionarios[0]

var sobrenomes = {}

var pessoasMaioresSalarios = []
var pessoasMenoresSalarios = []
para cada funcionario em jsonFuncionarios.funcionarios {
    totalSalarios += funcionario.salario
    numeroFuncionarios += 1
    se funcionario.salario > pessoaSalarioMaximo.salario {
        pessoaSalarioMaximo = funcionario
        pessoasMaioresSalarios.adicionar(funcionario)
    }

    se funcionario.salario < pessoaSalarioMinimo.salario {
        pessoaSalarioMinimo = funcionario
        pessoasMenoresSalarios.adicionar(funcionario)
    }

    se !sobrenomes.contem(funcionario.sobrenome) {
        sobrenomes[funcionario.sobrenome] = {
            'nomeCompleto': funcionario.nome + ' ' + funcionario.sobrenome,
            'maiorSalario': funcionario.salario,
            'numeroFuncionarios': 1,
            'listaFuncionarios': []
        }
        continua
    }

    se sobrenomes[funcionario.sobrenome].maiorSalario <= funcionario.salario {
        sobrenomes[funcionario.sobrenome].nomeCompleto = funcionario.nome + ' ' + funcionario.sobrenome
        sobrenomes[funcionario.sobrenome].maiorSalario = funcionario.salario
        sobrenomes[funcionario.sobrenome].numeroFuncionarios += 1
        sobrenomes[funcionario.sobrenome].listaFuncionarios.adicionar(funcionario)
    }
}

escreva("Total de salários: ${totalSalarios}")
escreva("Total de funcionários: ${numeroFuncionarios}")

var mediaSalarial = totalSalarios / numeroFuncionarios
escreva("global_max|${pessoaSalarioMaximo.nome} ${pessoaSalarioMaximo.sobrenome}|${pessoaSalarioMaximo.salario}")
escreva("global_min|${pessoaSalarioMinimo.nome} ${pessoaSalarioMinimo.sobrenome}|${pessoaSalarioMinimo.salario}")
escreva("global_avg|${mediaSalarial.formatar()}")

var analiticosAreas = {}

para cada area em jsonFuncionarios.areas {
    // escreva(area)
    analiticosAreas[area['codigo']] = {
        'codigo': area['codigo'],
        'nome': area['nome'],
        'pessoaSalarioMaximo': nulo,
        'pessoaSalarioMinimo': nulo,
        'pessoasSalarioMaximo': [],
        'pessoasSalarioMinimo': [],
        'mediaSalarial': 0,
        'totalSalarios': 0,
        'numeroFuncionarios': 0
    }
}

para cada funcionario em jsonFuncionarios.funcionarios {
    // escreva(funcionario)
    var area = analiticosAreas[funcionario['area']]
    area.totalSalarios += funcionario.salario
    area.numeroFuncionarios += 1
    se area.pessoaSalarioMaximo == nulo ou funcionario.salario > area.pessoaSalarioMaximo.salario {
        area.pessoaSalarioMaximo = funcionario
        area.pessoasSalarioMaximo.adicionar(funcionario)
    }

    se area.pessoaSalarioMinimo == nulo ou funcionario.salario < area.pessoaSalarioMinimo.salario {
        area.pessoaSalarioMinimo = funcionario
        area.pessoasSalarioMinimo.adicionar(funcionario)
    }
}

// Cálculo das médias, áreas com o maior e menor número de funcionários
var areaMenosFuncionarios = {
    'numeroFuncionarios': 99999
}
var areaMaisFuncionarios = {
    'numeroFuncionarios': 0
}

var areasMenosFuncionarios = []
var areasMaisFuncionarios = []
para cada {chave, area} em analiticosAreas {
    area.mediaSalarial = area.totalSalarios / area.numeroFuncionarios

    se areaMenosFuncionarios.numeroFuncionarios >= area.numeroFuncionarios {
        areaMenosFuncionarios = area
        areasMenosFuncionarios.adicionar(area)
    }

    se areaMaisFuncionarios.numeroFuncionarios <= area.numeroFuncionarios {
        areaMaisFuncionarios = area
        areasMaisFuncionarios.adicionar(area)
    }
}

para cada {codigoArea, area} em analiticosAreas {
    para cada pessoa em area.pessoasSalarioMaximo {
        se pessoa.salario == area.pessoaSalarioMaximo.salario {
            escreva("area_max|${area.nome}|${pessoa.nome} ${pessoa.sobrenome}|${pessoa.salario}")
        }
    }

    para cada pessoa em area.pessoasSalarioMinimo {
        se pessoa.salario == area.pessoaSalarioMinimo.salario {
            escreva("area_min|${area.nome}|${pessoa.nome} ${pessoa.sobrenome}|${pessoa.salario}")
        }
    }

    escreva("area_avg|${area.nome}|${area.mediaSalarial.formatar()}")
}

para cada area em areasMaisFuncionarios {
    se area.numeroFuncionarios == areaMaisFuncionarios.numeroFuncionarios {
        escreva("most_employees|${area.nome}|${area.numeroFuncionarios}")
    }
}

para cada area em areasMenosFuncionarios {
    se area.numeroFuncionarios == areaMenosFuncionarios.numeroFuncionarios {
        escreva("least_employees|${area.nome}|${area.numeroFuncionarios}")
    }
}

para cada {sobrenome, dados} em sobrenomes {
    escreva(dados)
    para cada funcionario em dados.listaFuncionarios {
        escreva("last_name_max|${sobrenome}|${funcionario.nome} ${funcionario.sobrenome}|${funcionario.salario}")
    }
    // escreva("last_name_max|${sobrenome}|${dados.nomeCompleto}|${dados.maiorSalario}")
}
